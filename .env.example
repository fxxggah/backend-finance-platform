# ============================================================
# finance-platform — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env com valores reais.
# ============================================================

# ---- Banco de dados ----------------------------------------
DB_URL=jdbc:mysql://localhost:3306/finance_platform_dev
DB_USER=root
DB_PASSWORD=

# ---- JWT ---------------------------------------------------
# Mínimo 32 bytes. Gere com: openssl rand -hex 32
JWT_SECRET=GcxdTPal4FjEHPpFO47o6JVbZz1TrX3DAqXXpN+UMTQ

# ---- Google OAuth2 -----------------------------------------
# Crie em https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth 2.0 > Aplicativo da Web"
GOOGLE_CLIENT_ID=

# ---- CORS --------------------------------------------------
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

